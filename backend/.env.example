PORT=5000
NODE_ENV=development
# MongoDB. Local:  mongodb://127.0.0.1:27017/virat_chowdary_university
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/virat_chowdary_university
MONGO_URI=mongodb://127.0.0.1:27017/virat_chowdary_university
JWT_ACCESS_SECRET=change_this_to_a_long_random_string
JWT_ACCESS_EXPIRES=1d
CLIENT_URL=http://localhost:5173
UNIVERSITY_NAME=Virat Chowdary University
UNIVERSITY_TIMEZONE=Asia/Kolkata

# Email used to send OTP codes.
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=you@gmail.com,
# SMTP_PASS=<16-character Google App Password>
# If these are empty (development only), the OTP is printed in this terminal instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Virat Chowdary University <no-reply@vcu.edu>"

# First Super Admin, created by:  npm run seed
SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_EMAIL=admin@vcu.edu
SUPER_ADMIN_PASSWORD=replace_with_a_strong_unique_password

# Development only: password of the sample accounts made by  npm run seed:demo-users
DEMO_STUDENT_PASSWORD=replace_with_a_demo_only_password

# Only for  npm run test:api  (a separate, empty database that the test is allowed to wipe)
# TEST_MONGO_URI=mongodb://127.0.0.1:27017/vcu_test

# Online fee payment. In development the built-in "sandbox" checkout is used (no real money moves).
# In production online payment stays switched off until a real gateway is connected (see
# backend/src/modules/payments/payments.service.js). Fees can always be collected at the accounts counter.
# PAYMENT_PROVIDER=sandbox
