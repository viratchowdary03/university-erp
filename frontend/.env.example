# Where the website sends its API calls.
#   /api  = the same address as the website; in development Vite forwards it to the backend (port 5000).
#   Use a full address such as https://api.example.com/api when the API is hosted elsewhere
#   (then add the website's address to CLIENT_URL in backend/.env).
VITE_API_URL=/api

# false = real mode: talks to the backend and the database (everything works)
# true  = demo mode: sample data in the browser, no backend (only the first 8 modules, read-mostly)
VITE_MOCK_AUTH=false
